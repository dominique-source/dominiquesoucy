SITE_URL=https://dominiquesoucy.com
# Optional confirmed destinations, HTTPS only
PURINSTINCT_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=

# Server only. Set a private numeric code; no default is shipped.
STUDIO_ACCESS_CODE=
# Required for deployments (Upstash-compatible Redis REST). Development uses expiring process memory.
STUDIO_REDIS_URL=
STUDIO_REDIS_TOKEN=
# Optional: without this, explicitly labelled local demo remains available after authentication.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Only for loopback development HTTP. Ignored in production; leave unset on Vercel.
STUDIO_LOCAL_HTTP=

# V7.1 community data (libSQL/Turso). Local development defaults to .data/questions.db.
QUESTIONS_DATABASE_URL=
QUESTIONS_DATABASE_AUTH_TOKEN=
QUESTIONS_PRIVACY_SECRET=
# Private Vercel Blob store. Never create a public store for uploaded contributions.
BLOB_READ_WRITE_TOKEN=
# Required for public media publication in deployed environments.
# HTTPS service receives the media bytes and returns JSON {"allowed": true|false}.
QUESTIONS_MEDIA_SCAN_URL=
QUESTIONS_MEDIA_SCAN_TOKEN=
# Optional Cloudflare Turnstile (configure both together).
NEXT_PUBLIC_QUESTIONS_TURNSTILE_KEY=
QUESTIONS_TURNSTILE_SECRET=
QUESTIONS_MAX_BYTES=3000000
QUESTIONS_AUDIO_SECONDS=60
QUESTIONS_VIDEO_SECONDS=30
